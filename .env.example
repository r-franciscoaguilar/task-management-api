DATABASE_URL=sqlite:///./app.db

# "smtp" opens a real SMTP connection and delivers. "noop" discards messages
# without sending -- only for deliberately switching email off.
EMAIL_BACKEND=smtp

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@task-api.local
SMTP_USE_TLS=false
SMTP_TIMEOUT=10
